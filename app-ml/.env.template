# Airflow Email Configuration
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git (it's in .gitignore)

# Gmail SMTP Configuration
# To use Gmail, you need to create an App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Other (Custom name)"
# 3. Copy the generated password
AIRFLOW__SMTP__SMTP_USER=cnyagakan@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-app-password-here

# Alternative: Use a different SMTP provider
# For other providers, update docker-compose.yaml:
# - AIRFLOW__SMTP__SMTP_HOST
# - AIRFLOW__SMTP__SMTP_PORT
# - AIRFLOW__SMTP__SMTP_STARTTLS
# - AIRFLOW__SMTP__SMTP_SSL

# MinIO Credentials (already in credentials.yml, but can override here)
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# PostgreSQL (optional override)
# POSTGRES_USER=airflow
# POSTGRES_PASSWORD=airflow
# POSTGRES_DB=airflow

# ==============================================================================
# Demand Forecasting ML System - Environment Configuration
# ==============================================================================
# SECURITY WARNING: Never commit the actual .env file to version control!
# This is a template. Copy to .env and update with real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# MinIO / S3 Configuration
# ------------------------------------------------------------------------------
# IMPORTANT: For Docker-internal communication use 'minio' hostname
# For local development outside Docker use 'host.docker.internal' or 'localhost'
MINIO_ENDPOINT=http://minio:9000
# Root user credentials (for MinIO admin)
MINIO_ROOT_USER=CHANGE_IN_PRODUCTION
MINIO_ROOT_PASSWORD=CHANGE_IN_PRODUCTION
# Access credentials (for application access - can be same as root for dev)
MINIO_ACCESS_KEY=CHANGE_IN_PRODUCTION
MINIO_SECRET_KEY=CHANGE_IN_PRODUCTION
S3_BUCKET=demand-forecasting
# MLflow S3 endpoint (must be set for MLflow to use MinIO)
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=${MINIO_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${MINIO_SECRET_KEY}

# ------------------------------------------------------------------------------
# Email / SMTP Configuration
# ------------------------------------------------------------------------------
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=your-email@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-app-password
AIRFLOW__SMTP__SMTP_MAIL_FROM=airflow@demand-forecasting.local

# ------------------------------------------------------------------------------
# Airflow Core Configuration
# ------------------------------------------------------------------------------
AIRFLOW__CORE__FERNET_KEY=GENERATE_WITH_CRYPTOGRAPHY_FERNET
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
# Note: Replace ${POSTGRES_PASSWORD} with your actual password
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ------------------------------------------------------------------------------
# Airflow Webserver Configuration
# ------------------------------------------------------------------------------
AIRFLOW__WEBSERVER__SECRET_KEY=GENERATE_RANDOM_SECRET_KEY
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False

# ------------------------------------------------------------------------------
# Airflow Admin User
# ------------------------------------------------------------------------------
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_IN_PRODUCTION
AIRFLOW_ADMIN_EMAIL=admin@demand-forecasting.local

# ------------------------------------------------------------------------------
# Kedro Configuration
# ------------------------------------------------------------------------------
KEDRO_ENV=local
KEDRO_PROJECT_PATH=/opt/airflow
KEDRO_CONF_SOURCE=conf

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_IN_PRODUCTION
# Passwords for service-specific database users (used by init-multiple-dbs.sh)
MLFLOW_DB_PASSWORD=CHANGE_IN_PRODUCTION
OPTUNA_DB_PASSWORD=CHANGE_IN_PRODUCTION

# ------------------------------------------------------------------------------
# Redis Configuration (Celery Backend)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Redis password (REQUIRED for production)
REDIS_PASSWORD=CHANGE_IN_PRODUCTION
# Celery broker URL (uses Redis password)
AIRFLOW__CELERY__BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/airflow

# ------------------------------------------------------------------------------
# Python / Application Settings
# ------------------------------------------------------------------------------
PYTHONPATH=/opt/airflow/src
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_DEBUG=False

# ------------------------------------------------------------------------------
# Enhanced DAG Configuration (MLflow & Optuna)
# ------------------------------------------------------------------------------

# MLflow Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=demand_forecasting

# Optuna Persistence Configuration
OPTUNA_STORAGE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/optuna
OPTUNA_STUDY_NAME=demand_forecasting_study

# Email Alert Configuration
# Do NOT put personal emails here. Use environment variables only in production.
AIRFLOW_ALERT_EMAIL=alerts@yourdomain.com

# API Key Configuration (comma-separated, for model server authentication)
VALID_API_KEYS=your-api-key-1,your-api-key-2

# ------------------------------------------------------------------------------
# Grafana Configuration
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_IN_PRODUCTION

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DISABLE_EMAIL_ALERTS=False

# ------------------------------------------------------------------------------
# PRODUCTION DEPLOYMENT CHECKLIST
# ------------------------------------------------------------------------------
# Before deploying to production, ensure ALL of the following are changed:
# 
# 1. MINIO_ROOT_USER / MINIO_ROOT_PASSWORD - Generate strong credentials
# 2. MINIO_ACCESS_KEY / MINIO_SECRET_KEY - Generate strong credentials  
# 3. POSTGRES_PASSWORD - Generate strong password (min 16 chars)
# 4. MLFLOW_DB_PASSWORD - Generate strong password
# 5. OPTUNA_DB_PASSWORD - Generate strong password
# 6. REDIS_PASSWORD - Generate strong password
# 7. AIRFLOW__CORE__FERNET_KEY - Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 8. AIRFLOW__WEBSERVER__SECRET_KEY - Generate random 32+ char string
# 9. AIRFLOW_ADMIN_PASSWORD - Generate strong password
# 10. GRAFANA_ADMIN_PASSWORD - Generate strong password
# 11. VALID_API_KEYS - Generate unique API keys for each client
# 12. SMTP credentials - Use app-specific passwords, not main account passwords
#
# NEVER commit the actual .env file to version control!

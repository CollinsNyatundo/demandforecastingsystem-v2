{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "grafana",
                    "uid": "-- Grafana --"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "title": "Prediction Request Rate",
            "description": "Number of prediction requests per second, by status",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15,
                        "showPoints": "never"
                    },
                    "unit": "reqps"
                }
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "targets": [
                {
                    "expr": "rate(prediction_requests_total{status=\"success\"}[5m])",
                    "legendFormat": "Success",
                    "refId": "A"
                },
                {
                    "expr": "rate(prediction_requests_total{status=\"error\"}[5m])",
                    "legendFormat": "Error",
                    "refId": "B"
                },
                {
                    "expr": "rate(prediction_requests_total[5m])",
                    "legendFormat": "Total",
                    "refId": "C"
                }
            ]
        },
        {
            "title": "Prediction Latency (p50 / p95 / p99)",
            "description": "Histogram quantiles for end-to-end prediction duration",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    },
                    "unit": "s"
                }
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, rate(prediction_duration_seconds_bucket[5m]))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, rate(prediction_duration_seconds_bucket[5m]))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, rate(prediction_duration_seconds_bucket[5m]))",
                    "legendFormat": "p99",
                    "refId": "C"
                }
            ]
        },
        {
            "title": "Total Requests (since start)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 1000
                            },
                            {
                                "color": "red",
                                "value": 10000
                            }
                        ]
                    },
                    "unit": "short",
                    "mappings": []
                }
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "targets": [
                {
                    "expr": "prediction_requests_total",
                    "legendFormat": "Total",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Error Rate",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    },
                    "unit": "percentunit"
                }
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "targets": [
                {
                    "expr": "rate(prediction_requests_total{status=\"error\"}[5m]) / clamp_min(rate(prediction_requests_total[5m]), 0.0001)",
                    "legendFormat": "Error Rate",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Model Accuracy",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.8
                            },
                            {
                                "color": "green",
                                "value": 0.9
                            }
                        ]
                    },
                    "unit": "percentunit"
                }
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "targets": [
                {
                    "expr": "model_accuracy",
                    "legendFormat": "Accuracy",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Avg Latency (last 5m)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 8
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.1
                            },
                            {
                                "color": "red",
                                "value": 0.5
                            }
                        ]
                    },
                    "unit": "s"
                }
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "targets": [
                {
                    "expr": "rate(prediction_duration_seconds_sum[5m]) / clamp_min(rate(prediction_duration_seconds_count[5m]), 0.0001)",
                    "legendFormat": "Avg Latency",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Model Server — CPU Usage",
            "description": "Process CPU seconds consumed by the model server (prometheus_client built-in)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 12
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 20
                    },
                    "unit": "percent"
                }
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "targets": [
                {
                    "expr": "rate(process_cpu_seconds_total{job=\"model-server\"}[1m]) * 100",
                    "legendFormat": "CPU %",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Model Server — Memory (RSS)",
            "description": "Resident Set Size memory used by the model server process",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 12
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 20
                    },
                    "unit": "bytes"
                }
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "targets": [
                {
                    "expr": "process_resident_memory_bytes{job=\"model-server\"}",
                    "legendFormat": "RSS Memory",
                    "refId": "A"
                },
                {
                    "expr": "process_virtual_memory_bytes{job=\"model-server\"}",
                    "legendFormat": "Virtual Memory",
                    "refId": "B"
                }
            ]
        },
        {
            "title": "Open File Descriptors",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 0,
                "y": 20
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 1
                    },
                    "unit": "short"
                }
            },
            "targets": [
                {
                    "expr": "process_open_fds{job=\"model-server\"}",
                    "legendFormat": "Open FDs",
                    "refId": "A"
                },
                {
                    "expr": "process_max_fds{job=\"model-server\"}",
                    "legendFormat": "Max FDs",
                    "refId": "B"
                }
            ]
        },
        {
            "title": "Prometheus Scrape Duration",
            "type": "timeseries",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 8,
                "y": 20
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 1
                    },
                    "unit": "s"
                }
            },
            "targets": [
                {
                    "expr": "scrape_duration_seconds{job=\"model-server\"}",
                    "legendFormat": "Scrape Duration",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Up / Health Status",
            "type": "stat",
            "gridPos": {
                "h": 6,
                "w": 8,
                "x": 16,
                "y": 20
            },
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "green",
                                "value": 1
                            }
                        ]
                    },
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": {
                                    "text": "DOWN"
                                },
                                "1": {
                                    "text": "UP"
                                }
                            }
                        }
                    ],
                    "unit": "short"
                }
            },
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ]
                }
            },
            "targets": [
                {
                    "expr": "up{job=\"model-server\"}",
                    "legendFormat": "Model Server",
                    "refId": "A"
                },
                {
                    "expr": "up{job=\"prometheus\"}",
                    "legendFormat": "Prometheus",
                    "refId": "B"
                }
            ]
        }
    ],
    "refresh": "30s",
